{
  "name": "seat-lock",
  "version": "1.0.0",
  "description": "Secure, concurrent event seat-booking platform for college fest",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "test": "node --test tests/*.test.js",
    "test:phase1": "node --test tests/phase1-rbac.test.js",
