<%- include('../layouts/header') %>

<div style="max-width: 440px; margin: 3rem auto;">
  <div class="card">
    <div class="card-header" style="text-align: center; display: block; border-bottom: none; margin-bottom: 0.5rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700;">Account Login</h2>
      <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.25rem;">Enter credentials to access SeatLock</p>
    </div>

    <% if (error) { %>
      <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.88rem;">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input type="hidden" name="next" value="<%= nextUrl %>">

      <div style="margin-bottom: 1rem;">
        <label for="email" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text-muted);">Email Address</label>
        <input type="email" id="email" name="email" required value="<%= email %>"
               style="width: 100%; padding: 0.65rem 0.85rem; background: #0f172a; border: 1px solid var(--card-border); border-radius: 6px; color: var(--text); font-size: 0.95rem;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label for="password" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--text-muted);">Password</label>
        <input type="password" id="password" name="password" required value="Password123!"
               style="width: 100%; padding: 0.65rem 0.85rem; background: #0f172a; border: 1px solid var(--card-border); border-radius: 6px; color: var(--text); font-size: 0.95rem;">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem; font-size: 1rem;">Sign In</button>
    </form>

    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--card-border);">
      <p style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 0.75rem; text-align: center; font-weight: 700;">Demo Quick-Fill Accounts</p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('admin@collegefest.edu')">Admin</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('organizer@collegefest.edu')">Organizer</button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('student@collegefest.edu')">Student</button>
      </div>
    </div>
  </div>
</div>

<script>
  function quickFill(email) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = 'Password123!';
  }
</script>

<%- include('../layouts/footer') %>
