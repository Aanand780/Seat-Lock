<%- include('partials/header') %>

<div style="max-width: 580px; margin: 4rem auto; text-align: center;">
  <div class="card" style="border-top: 4px solid var(--warning); padding: 2.5rem 2rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h1 style="font-size: 2rem; font-weight: 800; color: #fbbf24; margin-bottom: 0.5rem;">409 Conflict</h1>
    <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Reservation Conflict</h3>
    
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.5;">
      <%= message || 'A conflict occurred while attempting to hold or update this resource.' %>
    </p>

    <% if (typeof unavailableSeats !== 'undefined' && unavailableSeats && unavailableSeats.length > 0) { %>
      <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 2rem; text-align: left;">
        <div style="font-weight: 700; color: #fbbf24; font-size: 0.9rem; margin-bottom: 0.5rem;">
          Unavailable Seats Identified:
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <% unavailableSeats.forEach(seat => { %>
            <span style="background: #dc2626; color: #fff; padding: 0.25rem 0.6rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem;">
              <%= seat %>
            </span>
          <% }) %>
        </div>
        <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.75rem;">
          Multi-seat holds are strictly <strong>all-or-nothing</strong>. None of the requested seats were reserved.
        </p>
      </div>
    <% } %>

    <div style="display: flex; justify-content: center; gap: 1rem;">
      <% if (typeof eventId !== 'undefined' && eventId) { %>
        <a href="/events/<%= eventId %>/seats" class="btn btn-primary">Refresh Seat Map</a>
      <% } else { %>
        <a href="/events" class="btn btn-primary">Back to Events</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
