<%- include('partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700;">User & Role Management</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Administrator console to view users and modify authorization roles</p>
  </div>
</div>

<% if (typeof successMsg !== 'undefined' && successMsg) { %>
  <div class="alert alert-success"><%= successMsg %></div>
<% } %>

<div class="card" style="padding: 0; overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border); background: rgba(15, 23, 42, 0.4); color: var(--text-muted);">
        <th style="padding: 0.85rem 1.25rem;">User ID</th>
        <th style="padding: 0.85rem 1.25rem;">Name</th>
        <th style="padding: 0.85rem 1.25rem;">Email</th>
        <th style="padding: 0.85rem 1.25rem;">Current Role</th>
        <th style="padding: 0.85rem 1.25rem;">Change Role</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 0.85rem 1.25rem; font-family: monospace; font-size: 0.8rem; color: var(--text-muted);"><%= u.id %></td>
          <td style="padding: 0.85rem 1.25rem; font-weight: 600;"><%= u.name %></td>
          <td style="padding: 0.85rem 1.25rem; color: var(--text-muted);"><%= u.email %></td>
          <td style="padding: 0.85rem 1.25rem;">
            <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
          </td>
          <td style="padding: 0.85rem 1.25rem;">
            <form action="/admin/users/<%= u.id %>/role" method="POST" style="display: flex; gap: 0.5rem; align-items: center;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="role" style="padding: 0.35rem 0.6rem; border-radius: 4px; border: 1px solid var(--border); background: var(--bg); color: #fff; font-size: 0.85rem;">
                <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Student</option>
                <option value="organizer" <%= u.role === 'organizer' ? 'selected' : '' %>>Organizer</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select>
              <button type="submit" class="btn btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">Update</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
