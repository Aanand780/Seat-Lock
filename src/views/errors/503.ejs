<%- include('../layouts/header') %>

<div style="max-width: 580px; margin: 4rem auto; text-align: center;">
  <div class="card" style="border-color: rgba(245, 158, 11, 0.4); box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.2);">
    <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">⏳</div>
    <h1 style="font-size: 2rem; font-weight: 800; color: #fcd34d; margin-bottom: 0.5rem;">503 &mdash; Server Busy / Lock Timeout</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 1.5rem;">
      <%= message || 'The seat lock could not be acquired within 2 seconds due to heavy concurrent demand.' %>
    </p>

    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--card-border); border-radius: 8px; padding: 1rem; text-align: left; font-size: 0.85rem; margin-bottom: 1.5rem;">
      <p style="color: var(--text-muted); line-height: 1.4;">
        To prevent deadlocks and indefinite waits during peak bookings, SeatLock enforces a strict 2-second row-lock timeout. Please retry your request in a moment.
      </p>
    </div>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <button onclick="window.location.reload()" class="btn btn-primary">Retry Now</button>
      <a href="/events" class="btn btn-secondary">Browse Events</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
