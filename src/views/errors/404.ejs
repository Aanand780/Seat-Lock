<%- include('../layouts/header') %>

<div style="max-width: 540px; margin: 4rem auto; text-align: center;">
  <div class="card">
    <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🔍</div>
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">404 &mdash; Page Not Found</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 1.5rem;">
      <%= message || 'The requested page or resource could not be found.' %>
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/events" class="btn btn-primary">Return to Events</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
