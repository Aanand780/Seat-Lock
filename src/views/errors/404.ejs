<%- include('../layouts/header') %>

<div style="max-width: 540px; margin: 4rem auto; text-align: center;">
  <div class="card" style="box-shadow: var(--shadow-md); padding: 2.5rem 2rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: var(--bg-subtle); color: var(--text-muted); border-radius: 50%; margin-bottom: 1.25rem; border: 1px solid var(--border-default);">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>

    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">
      404 &mdash; Page Not Found
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.9375rem; margin-bottom: 1.75rem; line-height: 1.5;">
      <%= message || 'The requested page or resource could not be found or has expired.' %>
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/events" class="btn btn-primary" style="font-weight: 600;">Return to Events Directory</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
