<%- include('../layouts/header') %>

<div style="max-width: 580px; margin: 4rem auto; text-align: center;">
  <div class="card" style="border-color: rgba(239, 68, 68, 0.4); background: rgba(30, 41, 59, 0.95); box-shadow: 0 10px 25px -5px rgba(239, 68, 68, 0.2);">
    <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🚫</div>
    <h1 style="font-size: 2rem; font-weight: 800; color: #fca5a5; margin-bottom: 0.5rem;">403 &mdash; Access Denied</h1>
    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 1.5rem;">
      <%= reason || 'You do not have permission to access the requested resource.' %>
    </p>

    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--card-border); border-radius: 8px; padding: 1rem; text-align: left; font-size: 0.85rem; margin-bottom: 1.5rem;">
      <div style="margin-bottom: 0.4rem;">
        <span style="color: var(--text-muted);">Attempted Path:</span>
        <code style="color: #93c5fd; background: rgba(59, 130, 246, 0.1); padding: 0.1rem 0.35rem; border-radius: 4px;"><%= path || 'N/A' %></code>
      </div>
      <div style="margin-bottom: 0.4rem;">
        <span style="color: var(--text-muted);">Your Role:</span>
        <span class="role-badge role-<%= locals.user ? locals.user.role : 'ANONYMOUS' %>">
          <%= locals.user ? locals.user.role : 'ANONYMOUS' %>
        </span>
      </div>
      <div>
        <span style="color: var(--text-muted);">Audit Status:</span>
        <span style="color: #fca5a5; font-weight: 600;">✓ Recorded in sharded audit log (ACCESS_DENIED)</span>
      </div>
    </div>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/events" class="btn btn-primary">Return to Events</a>
      <% if (!locals.user) { %>
        <a href="/login" class="btn btn-secondary">Log In</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
