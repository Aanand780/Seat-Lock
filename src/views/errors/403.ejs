<%- include('../layouts/header') %>

<div style="max-width: 540px; margin: 4rem auto; text-align: center;">
  <div class="card" style="box-shadow: var(--shadow-md); padding: 2.5rem 2rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; background: var(--danger-light); color: var(--danger); border-radius: 50%; margin-bottom: 1.25rem; border: 1px solid var(--danger-border);">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
      </svg>
    </div>
    
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; letter-spacing: -0.02em;">
      403 &mdash; Access Denied
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.9375rem; margin-bottom: 1.5rem; line-height: 1.5;">
      <%= reason || 'You do not have permission to access the requested resource.' %>
    </p>

    <div style="background: var(--bg-subtle); border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 1rem 1.25rem; text-align: left; font-size: 0.8125rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="color: var(--text-muted); font-weight: 500;">Attempted Resource:</span>
        <code style="color: var(--text-primary); background: #ffffff; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid var(--border-default);"><%= path || 'N/A' %></code>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="color: var(--text-muted); font-weight: 500;">Authenticated Role:</span>
        <span class="role-badge role-<%= locals.user ? locals.user.role : 'ANONYMOUS' %>">
          <%= locals.user ? locals.user.role : 'ANONYMOUS' %>
        </span>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 0.5rem;">
        <span style="color: var(--text-muted); font-weight: 500;">Audit Verification:</span>
        <span class="badge badge-danger" style="font-size: 0.72rem;">
          Recorded in Sharded Audit Log (ACCESS_DENIED)
        </span>
      </div>
    </div>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/events" class="btn btn-primary" style="font-weight: 600;">Return to Events</a>
      <% if (!locals.user) { %>
        <a href="/login" class="btn btn-secondary">Sign In</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
