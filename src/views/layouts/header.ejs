<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'SeatLock &bull; Enterprise College Fest Platform' %></title>
  
  <!-- Modern Typography: Inter font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Design System Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Inline critical design system fallback -->
  <style>
    :root {
      color-scheme: light;
      --bg-page: #f8fafc;
      --bg-surface: #ffffff;
      --bg-subtle: #f1f5f9;
      --border-default: #e2e8f0;
      --border-strong: #cbd5e1;
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --primary: #0f172a;
      --primary-hover: #1e293b;
      --accent: #2563eb;
      --shadow-xs: 0 1px 2px 0 rgba(15, 23, 42, 0.05);
      --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.06), 0 2px 4px -2px rgba(15, 23, 42, 0.04);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { min-width: 320px; background: var(--bg-page); }
    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }
    header.site-header {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border-default);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: var(--shadow-xs);
    }
    .navbar {
      max-width: 1280px;
      min-height: 64px;
      margin: 0 auto;
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text-primary);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }
    .brand-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: #0f172a;
      color: #ffffff;
      border-radius: 8px;
    }
    .brand-badge {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background: #f1f5f9;
      color: #64748b;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
      margin-left: 0.35rem;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      list-style: none;
      margin-left: 1.5rem;
    }
    .nav-links a {
      display: inline-flex;
      align-items: center;
      height: 36px;
      padding: 0 0.85rem;
      color: var(--text-secondary);
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .nav-links a:hover {
      color: var(--text-primary);
      background-color: #f1f5f9;
    }
    .user-panel {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-left: auto;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.25rem 0.65rem;
      background-color: #f8fafc;
      border: 1px solid var(--border-default);
      border-radius: 9999px;
    }
    .user-avatar {
      width: 26px;
      height: 26px;
      background: #0f172a;
      color: #ffffff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .user-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    .role-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      line-height: 1;
    }
    .role-ADMIN { background: #fdf2f8; color: #9d174d; border: 1px solid #fbcfe8; }
    .role-ORGANIZER { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .role-STUDENT { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .role-ANONYMOUS { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
    
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      height: 38px;
      padding: 0 1rem;
      border-radius: 6px;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      border: 1px solid transparent;
      white-space: nowrap;
      transition: all 0.15s ease-in-out;
    }
    .btn-primary {
      background: #0f172a;
      color: #ffffff !important;
      border-color: #0f172a;
    }
    .btn-primary:hover {
      background: #1e293b;
      border-color: #1e293b;
    }
    .btn-secondary {
      background: #ffffff;
      color: #0f172a !important;
      border-color: #cbd5e1;
    }
    .btn-secondary:hover {
      background: #f8fafc;
      border-color: #94a3b8;
    }
    .btn-sm {
      height: 32px;
      padding: 0 0.75rem;
      font-size: 0.8125rem;
    }
    main.main-content {
      flex: 1;
      max-width: 1280px;
      width: 100%;
      margin: 2rem auto 3.5rem;
      padding: 0 1.5rem;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1.5rem;
      box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.05);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e2e8f0;
    }
    @media (max-width: 768px) {
      .navbar { padding: 0.75rem 1rem; flex-wrap: wrap; }
      .nav-links { order: 3; width: 100%; margin-left: 0; padding-top: 0.5rem; border-top: 1px solid #f1f5f9; }
      main.main-content { margin: 1.5rem auto 2.5rem; padding: 0 1rem; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="navbar">
      <a href="/events" class="brand">
        <span class="brand-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </span>
        <span>SeatLock</span>
        <span class="brand-badge">Enterprise</span>
      </a>

      <ul class="nav-links">
        <li><a href="/events">Events</a></li>
        <% if (locals.user) { %>
          <% if (locals.isStudent || locals.isAdmin) { %>
            <li><a href="/my-bookings">My Bookings</a></li>
          <% } %>
          <% if (locals.isAdmin) { %>
            <li><a href="/admin/dashboard">Sales Dashboard</a></li>
            <li><a href="/admin/audit-logs">Audit Trail</a></li>
          <% } %>
          <% if (locals.user.role === 'ORGANIZER') { %>
            <li><a href="/organizer/dashboard">Sales Dashboard</a></li>
          <% } %>
        <% } %>
      </ul>

      <div class="user-panel">
        <% if (locals.user) { %>
          <div class="user-profile">
            <span class="user-avatar"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></span>
            <span class="user-name"><%= user.name %></span>
            <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
          </div>
          <form action="/logout" method="POST" style="margin: 0;">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <button type="submit" class="btn btn-secondary btn-sm">Sign Out</button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn-secondary btn-sm">Sign In</a>
          <a href="/register" class="btn btn-primary btn-sm">Create Account</a>
        <% } %>
      </div>
    </div>
  </header>
  <main class="main-content">
