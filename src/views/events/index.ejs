<%- include('../layouts/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.5px;">College Fest Events</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.25rem;">
      <% if (locals.isAdmin) { %>
        Admin View: Showing all events across all organizers.
      <% } else if (locals.isOrganizer) { %>
        Organizer View: Showing events managed by you.
      <% } else { %>
        Student View: Browse and reserve numbered seats for college fest shows.
      <% } %>
    </p>
  </div>
</div>

<% if (events.length === 0) { %>
  <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
    <p style="color: var(--text-muted); font-size: 1.1rem;">No events found matching your permissions.</p>
  </div>
<% } else { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem;">
    <% events.forEach(event => { %>
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
            <span style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(event.start_time).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            <% if (event.is_published) { %>
              <span style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; text-transform: uppercase;">Published</span>
            <% } else { %>
              <span style="background: rgba(245, 158, 11, 0.2); color: #fcd34d; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 9999px; text-transform: uppercase;">Draft</span>
            <% } %>
          </div>

          <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;"><%= event.title %></h3>
          <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            <%= event.description || 'Join us for this exciting campus fest event!' %>
          </p>

          <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem;">
            <div>📍 <strong>Venue:</strong> <%= event.venue %></div>
            <div>👤 <strong>Organizer:</strong> <%= event.organizer_name %></div>
            <div>🪑 <strong>Total Seats:</strong> <%= event.total_seats || 30 %></div>
          </div>
        </div>

        <div style="display: flex; gap: 0.5rem; border-top: 1px solid var(--card-border); padding-top: 1rem; margin-top: auto;">
          <a href="/events/<%= event.id %>/seats" class="btn btn-primary btn-sm" style="flex: 1;">View Seat Map</a>
          <% if (locals.isAdmin || (locals.isOrganizer && locals.user.id === event.organizer_id)) { %>
            <a href="/events/<%= event.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
            <a href="/organizer/events/<%= event.id %>/attendees" class="btn btn-secondary btn-sm">Attendees</a>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../layouts/footer') %>
