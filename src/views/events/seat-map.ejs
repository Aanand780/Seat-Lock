<%- include('../layouts/header') %>

<div style="margin-bottom: 1.5rem;">
  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
    <a href="/events" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 500; display: inline-flex; align-items: center; gap: 0.35rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to Events</span>
    </a>
  </div>

  <% if (event.theme_photo) { %>
    <img src="<%= event.theme_photo %>" alt="Theme photo for <%= event.title %>" style="display: block; width: 100%; max-height: 320px; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: 1.25rem;">
  <% } %>

  <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.03em;">
        <%= event.title %>
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9375rem; margin-top: 0.25rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <span style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <%= event.venue %>
        </span>
        <span>&bull;</span>
        <span style="display: inline-flex; align-items: center; gap: 0.35rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <%= new Date(event.start_time).toLocaleString(undefined, { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
        </span>
      </p>
    </div>

    <!-- Real-time Live SSE Indicator -->
    <div id="sseStatusBadge" class="badge badge-success" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; font-weight: 600; box-shadow: var(--shadow-xs);">
      <span class="live-pulse-dot" style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
      <span>Live Seat Sync (SSE Active)</span>
    </div>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger" role="alert" style="margin-bottom: 1.5rem;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 0.1rem;">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <div><strong>Notice:</strong> <%= error %></div>
  </div>
<% } %>

<!-- Main Seating Chart Card -->
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">Auditorium Seating Grid</h2>
      <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.15rem;">Select numbered seats to hold with pessimistic row locks</p>
    </div>

    <!-- Legend -->
    <div style="display: flex; gap: 1.15rem; align-items: center; font-size: 0.8125rem; flex-wrap: wrap;">
      <span style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); font-weight: 500;">
        <span style="width: 14px; height: 14px; background: #10b981; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,0.1);"></span> Available
      </span>
      <span style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); font-weight: 500;">
        <span style="width: 14px; height: 14px; background: #2563eb; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,0.1);"></span> Held by You
      </span>
      <span style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); font-weight: 500;">
        <span style="width: 14px; height: 14px; background: #f59e0b; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,0.1);"></span> Held by Others
      </span>
      <span style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); font-weight: 500;">
        <span style="width: 14px; height: 14px; background: #ef4444; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,0.1);"></span> Booked
      </span>
      <span style="display: flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); font-weight: 500;">
        <span style="width: 14px; height: 14px; background: #64748b; border-radius: 3px; display: inline-block; border: 1px solid rgba(0,0,0,0.1);"></span> Blocked
      </span>
    </div>
  </div>

  <!-- Stage Indicator -->
  <div class="stage-banner">
    &mdash; AUDITORIUM STAGE FRONT &mdash;
  </div>

  <form id="holdForm" action="/events/<%= event.id %>/hold" method="POST">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

    <% if (Object.keys(seatsByRow).length === 0) { %>
      <div role="status" style="text-align: center; padding: 3rem 1rem; border: 1px dashed var(--border-strong); border-radius: var(--radius-md); color: var(--text-muted);">
        No seats have been generated for this event yet. Please contact the festival organizer.
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 0.85rem; align-items: center; padding: 1rem 0 2rem; overflow-x: auto;">
        <% Object.keys(seatsByRow).sort().forEach(row => { %>
          <div class="seat-row">
            <div class="seat-row-label"><%= row %></div>
            <div style="display: flex; gap: 0.45rem; flex-wrap: nowrap;">
              <% seatsByRow[row].forEach(seat => { %>
                <%
                  let bg = '#10b981'; // available
                  let cursor = 'pointer';
                  let disabled = false;
                  if (seat.state === 'BLOCKED') {
                    bg = '#64748b';
                    cursor = 'not-allowed';
                    disabled = true;
                  } else if (seat.state === 'BOOKED') {
                    bg = '#ef4444';
                    cursor = 'not-allowed';
                    disabled = true;
                  } else if (seat.state === 'HELD') {
                    bg = seat.heldByMe ? '#2563eb' : '#f59e0b';
                    cursor = seat.heldByMe ? 'pointer' : 'not-allowed';
                    disabled = !seat.heldByMe;
                  }
                %>
                <label style="position: relative; cursor: <%= cursor %>;" id="label-seat-<%= seat.id %>" title="Seat <%= seat.row_label %><%= seat.seat_number %> (<%= seat.state %>)">
                  <input type="checkbox" name="seatIds" value="<%= seat.id %>" <%= disabled ? 'disabled' : '' %>
                         style="position: absolute; opacity: 0; pointer-events: none;">
                  <div class="seat-badge" id="seat-<%= seat.id %>"
                       style="background: <%= bg %>; color: #ffffff;">
                    <%= seat.seat_number %>
                  </div>
                </label>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (locals.isStudent || locals.isAdmin) { %>
      <div class="seat-action-bar">
        <div>
          <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.2rem;">
            Seat Allocation Rules
          </div>
          <p class="seat-action-copy" id="seatSelectionStatus" role="status" aria-live="polite" tabindex="-1" style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
            Select between 1 and 4 seats. Holds expire automatically after 3 minutes.
          </p>
        </div>
        <button type="submit" class="btn btn-primary btn-lg" id="holdBtn" style="font-weight: 600; min-width: 240px;">
          Hold Selected Seats
        </button>
      </div>
    <% } else if (!locals.user) { %>
      <div style="margin-top: 2rem; text-align: center; padding: 1.5rem; background: var(--bg-subtle); border-radius: var(--radius-md); border: 1px solid var(--border-default);">
        <p style="color: var(--text-secondary); margin-bottom: 0.75rem; font-size: 0.9375rem;">You must be signed in as a student to hold and book seats.</p>
        <a href="/login" class="btn btn-primary btn-sm">Sign In to Continue</a>
      </div>
    <% } %>
  </form>
</div>

<!-- Waitlist Card (Bonus Item 3) -->
<% if (locals.isStudent || locals.isAdmin) { %>
  <div class="card" style="margin-bottom: 2rem; border-color: #e2e8f0; background: #fafbfc;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
      <div style="max-width: 650px;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
          <span class="badge badge-info" style="font-size: 0.7rem;">Automated Queue</span>
          <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin: 0;">Event Waitlist Protection</h3>
        </div>
        <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin: 0;">
          All seats currently held or booked? Join the FIFO waitlist to be automatically promoted when held seats expire or cancellations occur.
        </p>
      </div>
      <form action="/events/<%= event.id %>/waitlist" method="POST" style="margin: 0; display: flex; gap: 0.5rem; align-items: center;">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <select name="seatsCount" class="form-control" style="width: 120px; height: 38px; padding: 0.4rem 0.65rem; font-size: 0.875rem;">
          <option value="1">1 Seat</option>
          <option value="2">2 Seats</option>
          <option value="3">3 Seats</option>
          <option value="4">4 Seats</option>
        </select>
        <button type="submit" class="btn btn-secondary" style="height: 38px;">
          Join Waitlist
        </button>
      </form>
    </div>
  </div>
<% } %>

<!-- Organizer Seat Blocking Control Panel -->
<% if (locals.isAdmin || (locals.isOrganizer && locals.user.id === event.organizer_id)) { %>
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <div>
        <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">Organizer Seat Reservation & Blocking</h3>
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.15rem;">Reserve seats for judges, sound engineers, or equipment. Booked seats cannot be blocked.</p>
      </div>
      <span class="badge badge-warning">Organizer Exclusive</span>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
      <% Object.keys(seatsByRow).sort().forEach(row => { %>
        <% seatsByRow[row].forEach(seat => { %>
          <% if (seat.state !== 'BOOKED') { %>
            <form action="/events/<%= event.id %>/seats/<%= seat.id %>/block" method="POST" style="margin: 0; display: inline;">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
              <button type="submit" class="btn btn-sm <%= seat.state === 'BLOCKED' ? 'btn-secondary' : 'btn-primary' %>"
                      style="font-size: 0.75rem; padding: 0.25rem 0.6rem; height: 30px;"
                      title="Toggle Block for <%= seat.row_label %><%= seat.seat_number %>">
                <%= seat.row_label %><%= seat.seat_number %>: <%= seat.state === 'BLOCKED' ? 'Unblock' : 'Block' %>
              </button>
            </form>
          <% } %>
        <% }) %>
      <% }) %>
    </div>
  </div>
<% } %>

<script>
  // Dynamic Seat Selection Handler
  (() => {
    const form = document.getElementById('holdForm');
    const holdBtn = document.getElementById('holdBtn');
    const status = document.getElementById('seatSelectionStatus');
    const checkboxes = Array.from(document.querySelectorAll('input[name="seatIds"]'));
    if (!form || !holdBtn) return;

    const updateSelection = () => {
      const selected = checkboxes.filter(cb => cb.checked);
      
      // Update visual styles for badges
      checkboxes.forEach(cb => {
        const badge = document.getElementById('seat-' + cb.value);
        if (badge) {
          if (cb.checked) {
            badge.style.boxShadow = '0 0 0 3px #0f172a, 0 4px 6px -1px rgba(0, 0, 0, 0.1)';
            badge.style.transform = 'translateY(-2px) scale(1.08)';
          } else {
            badge.style.boxShadow = 'none';
            badge.style.transform = 'none';
          }
        }
      });

      const count = selected.length;
      if (count === 0) {
        holdBtn.disabled = true;
        holdBtn.textContent = 'Hold Selected Seats';
        if (status) status.textContent = 'Select between 1 and 4 seats. Holds expire automatically after 3 minutes.';
      } else if (count > 4) {
        holdBtn.disabled = true;
        holdBtn.textContent = 'Limit Exceeded: Max 4 Seats';
        if (status) status.textContent = `${count} seats selected. Please remove ${count - 4} seat(s) to continue.`;
      } else {
        holdBtn.disabled = false;
        holdBtn.textContent = `Hold ${count} Seat${count > 1 ? 's' : ''} for 3 Minutes`;
        
        const names = selected.map(input => {
          const badge = document.getElementById(`seat-${input.value}`);
          const label = document.getElementById(`label-seat-${input.value}`);
          const seatNumber = badge ? badge.textContent.trim() : '';
          const seatName = label ? label.title.replace(/^Seat /, '').replace(/ \(.+\)$/, '') : '';
          return seatName || seatNumber;
        });
        if (status) status.textContent = `Selected (${count}/4): ${names.join(', ')}`;
      }
    };

    checkboxes.forEach(cb => cb.addEventListener('change', updateSelection));
    
    form.addEventListener('submit', event => {
      const count = checkboxes.filter(cb => cb.checked).length;
      if (count < 1 || count > 4) {
        event.preventDefault();
        if (status) {
          status.textContent = count === 0
            ? 'Select at least one available seat to continue.'
            : 'You can hold up to 4 seats. Remove a seat to continue.';
          status.focus();
        }
        return;
      }
      holdBtn.disabled = true;
      holdBtn.textContent = 'Locking Selected Seats...';
    });

    updateSelection();
  })();

  // Live Real-Time SSE Synchronization
  if (window.EventSource) {
    const sse = new EventSource('/events/<%= event.id %>/seats/stream');
    const sseBadge = document.getElementById('sseStatusBadge');

    sse.onmessage = function(event) {
      try {
        const data = JSON.parse(event.data);
        if (data.type === 'SEAT_UPDATE' && Array.isArray(data.seatIds)) {
          data.seatIds.forEach(id => {
            const badge = document.getElementById('seat-' + id);
            const label = document.getElementById('label-seat-' + id);
            if (!badge || !label) return;
            const input = label.querySelector('input');

            if (data.state === 'BOOKED') {
              badge.style.background = '#ef4444';
              label.style.cursor = 'not-allowed';
              if (input) { input.disabled = true; input.checked = false; }
            } else if (data.state === 'HELD') {
              badge.style.background = '#f59e0b';
              label.style.cursor = 'not-allowed';
              if (input) { input.disabled = true; input.checked = false; }
            } else if (data.state === 'AVAILABLE') {
              badge.style.background = '#10b981';
              label.style.cursor = 'pointer';
              if (input) input.disabled = false;
            } else if (data.state === 'BLOCKED') {
              badge.style.background = '#64748b';
              label.style.cursor = 'not-allowed';
              if (input) { input.disabled = true; input.checked = false; }
            }
          });
        }
      } catch (e) {
        console.error('SSE data parse error:', e);
      }
    };

    sse.onerror = function() {
      if (sseBadge) {
        sseBadge.className = 'badge badge-warning';
        sseBadge.querySelector('span:last-child').textContent = 'Reconnecting Sync...';
      }
    };
  }
</script>

<%- include('../layouts/footer') %>
