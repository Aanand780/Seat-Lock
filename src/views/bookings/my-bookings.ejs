<%- include('../layouts/header') %>

<div class="page-header">
  <div>
    <div class="page-kicker">Student Portal</div>
    <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.03em;">My Seat Bookings</h1>
    <p style="color: var(--text-muted); font-size: 0.9375rem; margin-top: 0.25rem;">
      Manage your active reservations, attendee tickets, and 3-minute temporary holds
    </p>
  </div>
</div>

<!-- Active Holds Section -->
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-header">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <div>
        <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">Active Temporary Holds</h2>
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.1rem;">Holds reserve seats for 3 minutes. Confirm your booking before the timer expires.</p>
      </div>
    </div>
    <span class="badge badge-warning">3-Minute Expiry Window</span>
  </div>

  <% if (activeHolds.length === 0) { %>
    <div style="text-align: center; padding: 2.5rem 1rem; color: var(--text-muted);">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem; opacity: 0.5;">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p style="font-size: 0.9375rem; font-weight: 500;">No active seat holds</p>
      <p style="font-size: 0.8125rem; margin-top: 0.25rem;">Browse events to select and lock seats for upcoming performances.</p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <% activeHolds.forEach(hold => { %>
        <div data-hold-card style="background: #fffbeb; border: 1px solid #fde68a; border-radius: var(--radius-md); padding: 1.5rem; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
              <span class="badge badge-warning" style="font-size: 0.6875rem;">Held by You</span>
              <h3 style="font-size: 1.2rem; font-weight: 700; color: #92400e; margin: 0;"><%= hold.event_title %></h3>
            </div>
            
            <div style="font-size: 0.875rem; color: #78350f; margin-bottom: 0.75rem;">
              📍 <strong>Venue:</strong> <%= hold.venue %> &bull; 🕒 <%= new Date(hold.start_time).toLocaleString() %>
            </div>

            <div style="margin-bottom: 0.75rem;">
              <span style="font-size: 0.8125rem; font-weight: 600; color: #78350f; margin-right: 0.5rem;">Held Seats:</span>
              <% (hold.seats || []).forEach(s => { %>
                <span style="background: #f59e0b; color: #ffffff; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 4px; font-size: 0.8125rem; margin-right: 0.35rem; display: inline-block;">
                  <%= s.row %><%= s.number %>
                </span>
              <% }) %>
            </div>

            <div style="font-size: 0.9rem; font-weight: 700; color: #b45309;" id="timer-<%= hold.id %>" data-expires-at="<%= new Date(hold.expires_at).toISOString() %>" role="timer" aria-live="polite">
              Calculating time remaining…
            </div>
          </div>

          <form action="/holds/<%= hold.id %>/confirm" method="POST" style="margin: 0; background: #ffffff; border: 1px solid #fde68a; border-radius: var(--radius-md); padding: 1.25rem; min-width: 320px; box-shadow: var(--shadow-sm);">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <h4 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-default);">
              Confirm Attendee Details
            </h4>
            
            <% (hold.seats || []).forEach((s, index) => { %>
              <div class="form-group" style="margin-bottom: 0.75rem;">
                <label style="display: block; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.25rem;">
                  Ticket #<%= index + 1 %> (Seat <%= s.row %><%= s.number %>)
                </label>
                <input name="attendeeNames" required maxlength="100" autocomplete="name" placeholder="Full legal name" class="form-control" style="font-size: 0.875rem; padding: 0.45rem 0.65rem;">
              </div>
            <% }) %>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; font-weight: 600;">
              Confirm Booking & Generate Tickets
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Confirmed Bookings Section -->
<div class="card">
  <div class="card-header">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <div>
        <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary);">Confirmed Event Bookings</h2>
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.1rem;">Permanent admissions with secure check-in verification codes</p>
      </div>
    </div>
  </div>

  <% if (bookings.length === 0) { %>
    <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem; opacity: 0.5;">
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <p style="font-size: 0.9375rem; font-weight: 500;">No confirmed bookings yet</p>
      <p style="font-size: 0.8125rem; margin-top: 0.25rem;">Once you hold and confirm seats, your tickets and admission passes will appear here.</p>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% bookings.forEach(booking => { %>
        <div style="border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; background: #ffffff; transition: box-shadow 0.15s ease;">
          <div style="flex: 1; min-width: 280px;">
            <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
              <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); margin: 0;"><%= booking.event_title %></h3>
              <% if (booking.status === 'CONFIRMED') { %>
                <span class="badge badge-success">CONFIRMED</span>
              <% } else { %>
                <span class="badge badge-danger">CANCELLED</span>
              <% } %>
            </div>
            
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
              📍 <%= booking.venue %> &bull; Reference Code: <code style="font-weight: 700; color: var(--text-primary);">#<%= booking.id %></code>
            </div>

            <div>
              <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-secondary); margin-right: 0.4rem;">Seats & Attendees:</span>
              <% (booking.seats || []).forEach(s => { %>
                <span class="badge badge-info" style="font-size: 0.75rem; margin-right: 0.35rem; margin-bottom: 0.25rem;">
                  <%= s.row %><%= s.number %> &bull; <%= s.attendee_name || 'Student' %>
                </span>
              <% }) %>
            </div>
          </div>

          <% if (booking.status === 'CONFIRMED') { %>
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
              <a href="/bookings/<%= booking.id %>/tickets" class="btn btn-primary btn-sm" style="font-weight: 600;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9V2h12v7"></path>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>View & Print Tickets</span>
              </a>
              <form action="/bookings/<%= booking.id %>/cancel" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to cancel this booking? The seats will be released immediately.');">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger) !important; border-color: #fecaca;">
                  Cancel
                </button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  (() => {
    const timers = document.querySelectorAll('[data-expires-at]');
    const updateTimers = () => {
      const now = Date.now();
      timers.forEach(timer => {
        const remaining = Math.max(0, new Date(timer.dataset.expiresAt).getTime() - now);
        if (remaining === 0) {
          timer.textContent = 'Hold expired. Reload this page to release the seats.';
          timer.style.color = '#b91c1c';
          const submit = timer.closest('[data-hold-card]')?.querySelector('button[type="submit"]');
          if (submit) submit.disabled = true;
          return;
        }

        const totalSeconds = Math.ceil(remaining / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        timer.textContent = `Time left to confirm: ${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
      });
    };
    updateTimers();
    window.setInterval(updateTimers, 1000);
  })();
</script>

<%- include('../layouts/footer') %>
