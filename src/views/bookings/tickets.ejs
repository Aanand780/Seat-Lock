<%- include('../layouts/header') %>

<style>
  .ticket-sheet {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .ticket-pass {
    background: #ffffff;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .ticket-pass::before, .ticket-pass::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    background: var(--bg-page);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--border-default);
  }
  .ticket-pass::before { left: -10px; }
  .ticket-pass::after { right: -10px; }
  
  .ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--border-default);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }
  .ticket-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.875rem;
  }
  .ticket-row strong {
    color: var(--text-muted);
    font-weight: 500;
  }
  .ticket-row span {
    color: var(--text-primary);
    font-weight: 600;
  }
  
  @media print {
    header, footer, .no-print { display: none !important; }
    body, main.main-content { background: #ffffff !important; margin: 0 !important; padding: 0 !important; }
    .ticket-pass { box-shadow: none !important; border: 1px dashed #000000 !important; break-inside: avoid; margin-bottom: 2rem; }
    .ticket-pass::before, .ticket-pass::after { display: none; }
  }
</style>

<div class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <a href="/my-bookings" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 0.4rem;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>Back to My Bookings</span>
  </a>
  <button class="btn btn-primary" onclick="window.print()" style="display: inline-flex; align-items: center; gap: 0.4rem;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 6 2 18 2 18 9"></polyline>
      <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
      <rect x="6" y="14" width="12" height="8"></rect>
    </svg>
    <span>Print Tickets</span>
  </button>
</div>

<div class="page-header" style="margin-bottom: 1.5rem;">
  <div>
    <div class="page-kicker">Admission Passes</div>
    <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.03em;">
      <%= booking.event_title %>
    </h1>
    <p style="color: var(--text-muted); font-size: 0.9375rem; margin-top: 0.25rem;">
      Present this pass at the festival auditorium entrance for check-in verification
    </p>
  </div>
</div>

<div class="ticket-sheet">
  <% booking.tickets.forEach(ticket => { %>
    <article class="ticket-pass">
      <div class="ticket-header">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <div style="width: 24px; height: 24px; background: #0f172a; color: #ffffff; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 800;">
            SL
          </div>
          <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted);">
            SeatLock &bull; Fest Pass
          </span>
        </div>
        <span class="badge badge-success" style="font-size: 0.7rem;">Verified Admission</span>
      </div>

      <div style="margin-bottom: 1.25rem;">
        <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Attendee</span>
        <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-primary); margin-top: 0.15rem;">
          <%= ticket.attendee_name || 'Student Attendee' %>
        </h2>
      </div>

      <div style="background: var(--bg-subtle); border-radius: var(--radius-md); padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Allocated Seat</span>
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--accent);">
            <%= ticket.row %><%= ticket.number %>
          </div>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Booking Ref</span>
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); font-family: monospace;">
            #<%= booking.id %>
          </div>
        </div>
      </div>

      <div class="ticket-row">
        <strong>Venue</strong>
        <span><%= booking.venue %></span>
      </div>
      <div class="ticket-row">
        <strong>Event Time</strong>
        <span><%= new Date(booking.start_time).toLocaleString() %></span>
      </div>
      <div class="ticket-row">
        <strong>Confirmed Date</strong>
        <span><%= new Date(booking.created_at).toLocaleString() %></span>
      </div>

      <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px dashed var(--border-default); text-align: center; color: var(--text-tertiary); font-family: monospace; font-size: 0.75rem; letter-spacing: 2px;">
        ||| | ||||| || |||||| | || |||| |
      </div>
    </article>
  <% }) %>
</div>

<%- include('../layouts/footer') %>
